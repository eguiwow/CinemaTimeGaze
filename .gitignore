# --- secrets: never commit ---
src/.env
.env
*.env

# --- TMDB's own content: fetched, never redistributed ---
# The raw corpus carries TMDB plot summaries. Their terms cover use, not bulk
# redistribution, so the fetch output stays local and only this project's own
# derived results (data/targets.json, data/labels_*.jsonl) are committed.
data/tmdb_raw/
data/tmdb_films.jsonl
data/sample.json
data/movies.json
data/sample_wikipedia.json
data/_batch.txt

# --- generated build output ---
# Both are built by `make viz`. docs/ used to be committed; it is now built by
# .github/workflows/pages.yml on every push, so the published page can never
# drift from the source it claims to come from.
out/
docs/
logs/
_to_delete/

# --- junk ---
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# --- v4 ---
# TMDB responses and Wikipedia text: fetched, never redistributed (same rule as above).
# data/credits.json, data/studio_atlas.json and data/wishlist.json ARE committed.
data/tmdb_credits_raw/
data/wishlist_films.jsonl
data/plots_raw/
data/plots*.jsonl
data/handlabel/
# build-side database and regenerable id lists
data/corpus.db
data/*_ids.txt
