<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eguiwow.cinematimegaze</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/Projects/Ander/CinemaTimeGaze/scripts/nightly_classify.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key>
  <string>/tmp/cinematimegaze.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cinematimegaze.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
